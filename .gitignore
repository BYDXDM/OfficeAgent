# Build outputs and local runtime
build/
dist/
runtime/
lo76/
*.user

# Offline payload binaries are rebuilt from store/components.ini
payload/**/*.msu
payload/**/*.exe
payload/**/*.zip
payload/**/*.py

# Local tool state, secrets, settings, and logs
.mimosa/
**/.mimosa/
logs/
# Python bytecode: skills run as staged scripts, so importing one (e.g. from a
# test harness) would otherwise drop __pycache__ directories into the repo.
__pycache__/
*.pyc
tests/e2e/mock-server.log
tests/e2e/sample.csv
tests/e2e/sample_conv.xlsx
tests/fixtures/*_conv.*
tests/fixtures/invoice-list.xlsx
tests/fixtures/recon/*_vs_*.xlsx
*.local.json
config.json
memory.json
history.jsonl
audit.jsonl

# Unrelated third-party local data that landed in this folder (not part of OfficeAgent)
Data/
